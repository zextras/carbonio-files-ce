set -euo pipefail

SCRIPT="carbonio-files-hcl"
SETUP_CMD="carbonio-files-setup"
NAMES=(carbonio-files)

SD_DIR="${SD_DIR:-/etc/zextras/service-discover}"
MARKER="Generated by ${SCRIPT}"
DURATION_RE='^([0-9]+(\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$'

usage() {
  echo "Usage: ${SCRIPT} {migrate|render|show}" >&2
  exit 2
}

warn() {
  echo "Warning: $*" >&2
}

hcl_paths() {
  awk '
    function path(k,   i, p) {
      p = ""
      for (i = 1; i <= depth; i++) p = p stack[i] "."
      return p k
    }
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      sub(/[ \t]+$/, "", line)
      sub(/"[ \t]*,?[ \t]*(\/\/|#).*$/, "\"", line)
      if (line == "" || line ~ /^\/\// || line ~ /^#/) next
      if (line ~ /^[A-Za-z0-9_]+[ \t]*=[ \t]*".*",?$/) {
        k = line; sub(/[ \t]*=.*/, "", k)
        v = line; sub(/^[^=]*=[ \t]*"/, "", v); sub(/",?$/, "", v)
        print path(k) "\t" v
      } else if (line ~ /^[A-Za-z0-9_]+[ \t]*(=[ \t]*)?\{$/ || line ~ /^[A-Za-z0-9_]+[ \t]*=[ \t]*\[$/) {
        k = line; sub(/[ \t]*(=[ \t]*)?[\{\[]$/, "", k)
        stack[++depth] = k
      } else if (line ~ /^\{$/) {
        stack[++depth] = "[]"
      } else if (line ~ /^[\}\]]/) {
        if (depth > 0) depth--
      }
    }
  '
}

TEMPLATE=""
LIVE=""
ENVFILE=""
BAK=""
KEYS=()
DEFAULTS=()
KPATHS=()
KRAWS=()
KORDS=()
declare -A PROVIDED=()
tmp=""
FAILED=0

select_name() {
  TEMPLATE="${SD_DIR}/templates/$1-template.hcl"
  LIVE="${SD_DIR}/$1.hcl"
  ENVFILE="${SD_DIR}/$1.env"
  BAK="${LIVE}.bak"
  KEYS=()
  DEFAULTS=()
  KPATHS=()
  KRAWS=()
  KORDS=()
  PROVIDED=()
}

discover() {
  local p v raw ord
  [[ -r "${TEMPLATE}" ]] || { echo "Template not found: ${TEMPLATE}" >&2; return 1; }
  while IFS=$'\t' read -r p v; do
    raw="${v}"
    ord=0
    while [[ "${v}" =~ env\ \"([A-Za-z0-9_]+)\"\)\ \"([^\"]*)\" ]]; do
      ord=$((ord + 1))
      KEYS+=("${BASH_REMATCH[1]}")
      DEFAULTS+=("${BASH_REMATCH[2]}")
      KPATHS+=("${p}")
      KRAWS+=("${raw}")
      KORDS+=("${ord}")
      v="${v#*"${BASH_REMATCH[0]}"}"
    done
  done < <(hcl_paths < "${TEMPLATE}")
}

ere_escape() {
  printf '%s' "$1" | sed 's/[][\.*^$+?(){}|/]/\\&/g'
}

value_regex() {
  local rest="$1" re="^" pre
  while [[ "${rest}" =~ \{\{[^}]*\}\} ]]; do
    pre="${rest%%"${BASH_REMATCH[0]}"*}"
    re+="$(ere_escape "${pre}")(.*)"
    rest="${rest#*"${BASH_REMATCH[0]}"}"
  done
  printf '%s' "${re}$(ere_escape "${rest}")\$"
}

index_of() {
  local i
  for i in "${!KEYS[@]}"; do
    if [[ "${KEYS[i]}" == "$1" ]]; then
      echo "${i}"
      return 0
    fi
  done
  return 1
}

valid_value() {
  local def="$1" val="$2"
  if [[ "${def}" =~ ${DURATION_RE} ]]; then
    [[ "${val}" =~ ${DURATION_RE} ]]
  elif [[ "${def}" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
    [[ "${val}" =~ ^[A-Za-z0-9._:-]+$ ]]
  elif [[ "${def}" =~ ^[0-9]+$ ]]; then
    [[ "${val}" =~ ^[0-9]+$ ]]
  else
    [[ "${val}" != *'"'* && "${val}" != *"\\"* && ! "${val}" =~ [[:cntrl:]] ]]
  fi
}

load_env() {
  local line key val i n=0
  [[ -f "${ENVFILE}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    n=$((n + 1))
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    if [[ ! "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      warn "${ENVFILE}:${n}: malformed line ignored: ${line}"
      continue
    fi
    key="${BASH_REMATCH[1]}"
    val="${BASH_REMATCH[2]}"
    if [[ "${val}" =~ ^\"(.*)\"$ || "${val}" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    fi
    if ! i="$(index_of "${key}")"; then
      warn "${ENVFILE}:${n}: unknown key ${key} ignored"
      continue
    fi
    if ! valid_value "${DEFAULTS[i]}" "${val}"; then
      warn "${ENVFILE}:${n}: invalid value for ${key}: '${val}' (expected like ${DEFAULTS[i]}), using the default"
      continue
    fi
    PROVIDED["${key}"]="${val}"
  done < "${ENVFILE}"
}

migrate_one() {
  local source="" i val key old re
  local -a collected=()
  local -A seen=()
  [[ -f "${ENVFILE}" ]] && return 0
  discover
  if [[ -f "${LIVE}" ]]; then
    grep -qF "${MARKER}" "${LIVE}" && return 0
    source="${LIVE}"
  elif [[ -f "${LIVE}.rpmsave" ]] && ! grep -qF "${MARKER}" "${LIVE}.rpmsave"; then
    source="${LIVE}.rpmsave"
  else
    return 0
  fi
  old="$(hcl_paths < "${source}")"
  for i in "${!KEYS[@]}"; do
    [[ -v "seen[${KEYS[i]}]" ]] && continue
    val="$(awk -F'\t' -v p="${KPATHS[i]}" '$1 == p { print $2; exit }' <<< "${old}")"
    [[ -n "${val}" ]] || continue
    re="$(value_regex "${KRAWS[i]}")"
    if ! [[ "${val}" =~ ${re} ]]; then
      warn "${source}: ${KPATHS[i]} = '${val}' does not match the template, ${KEYS[i]} not migrated"
      continue
    fi
    val="${BASH_REMATCH[KORDS[i]]}"
    [[ "${val}" != "${DEFAULTS[i]}" ]] || continue
    if ! valid_value "${DEFAULTS[i]}" "${val}"; then
      warn "${source}: invalid value for ${KEYS[i]}: '${val}', not migrated"
      continue
    fi
    seen["${KEYS[i]}"]=1
    collected+=("${KEYS[i]}=${val}")
  done
  if ((${#collected[@]} > 0)); then
    tmp="$(mktemp "${SD_DIR}/.${ENVFILE##*/}.XXXXXX")"
    {
      echo "# Overrides for ${LIVE##*/}, keys and defaults: ${SCRIPT} show"
      echo "# Apply with ${SETUP_CMD}"
      printf '%s\n' "${collected[@]}"
    } > "${tmp}"
    chmod 0644 "${tmp}"
    mv -f "${tmp}" "${ENVFILE}"
    tmp=""
    for key in "${collected[@]}"; do
      echo "Migrated ${key} from ${source}"
    done
  fi
  if [[ "${source}" == "${LIVE}.rpmsave" && ! -e "${BAK}" ]]; then
    mv "${source}" "${BAK}"
    echo "Previous ${source} moved to ${BAK}"
  fi
}

backup_live() {
  local dest="${BAK}"
  [[ -f "${LIVE}" ]] || return 0
  grep -qF "${MARKER}" "${LIVE}" && return 0
  [[ -e "${dest}" ]] && dest="${BAK}.$(date +%Y%m%d%H%M%S)"
  cp -p "${LIVE}" "${dest}"
  echo "Previous ${LIVE} kept as ${dest}"
}

render_one() {
  local key vars=()
  discover
  load_env
  for key in "${!PROVIDED[@]}"; do
    vars+=("${key}=${PROVIDED[${key}]}")
  done
  tmp="$(mktemp "${SD_DIR}/.${LIVE##*/}.XXXXXX")"
  env -i PATH="${PATH}" "${vars[@]}" "${CONSUL_TEMPLATE:-consul-template}" \
    -template "${TEMPLATE}:${tmp}" -once > /dev/null
  if [[ ! -s "${tmp}" ]] || ! grep -qF "${MARKER}" "${tmp}"; then
    echo "Rendering ${TEMPLATE} produced no valid output" >&2
    return 1
  fi
  chmod 0644 "${tmp}"
  backup_live
  mv -f "${tmp}" "${LIVE}"
  tmp=""
  echo "Rendered ${LIVE}"
}

rep() {
  local out="" n="$1"
  while ((n-- > 0)); do out+="─"; done
  printf '%s' "${out}"
}

show_one() {
  local i w1=3 w2=7
  local -A seen=()
  discover
  for i in "${!KEYS[@]}"; do
    ((${#KEYS[i]} > w1)) && w1=${#KEYS[i]}
    ((${#DEFAULTS[i]} > w2)) && w2=${#DEFAULTS[i]}
  done
  echo
  echo "Sidecar Config (overridable by ${ENVFILE}, apply with ${SETUP_CMD})"
  echo
  echo "┌─$(rep "${w1}")─┬─$(rep "${w2}")─┐"
  printf '│ %-*s │ %-*s │\n' "${w1}" Key "${w2}" Default
  echo "├─$(rep "${w1}")─┼─$(rep "${w2}")─┤"
  for i in "${!KEYS[@]}"; do
    [[ -v "seen[${KEYS[i]}]" ]] && continue
    seen["${KEYS[i]}"]=1
    printf '│ %-*s │ %-*s │\n' "${w1}" "${KEYS[i]}" "${w2}" "${DEFAULTS[i]}"
  done
  echo "└─$(rep "${w1}")─┴─$(rep "${w2}")─┘"
  echo
}

each() {
  local fn="$1" name rc=0
  for name in "${NAMES[@]}"; do
    select_name "${name}"
    set +e
    (
      set -e
      trap '[[ -z "${tmp}" ]] || rm -f "${tmp}"' EXIT
      "${fn}"
    )
    rc=$?
    set -e
    if ((rc != 0)); then
      warn "${fn%_one} failed for ${name}"
      FAILED=1
    fi
  done
}

case "${1:-}" in
  migrate) each migrate_one ;;
  render) each render_one; exit "${FAILED}" ;;
  show) each show_one; exit "${FAILED}" ;;
  *) usage ;;
esac
