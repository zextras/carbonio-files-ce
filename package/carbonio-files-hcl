set -euo pipefail

SCRIPT="carbonio-files-hcl"
SETUP_CMD="carbonio-files-setup"
NAMES=(carbonio-files)

SD_DIR="${SD_DIR:-/etc/zextras/service-discover}"
DURATION_RE='^([0-9]+(\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$'

usage() {
  echo "Usage: ${SCRIPT} {render|show}" >&2
  exit 2
}

warn() {
  echo "Warning: $*" >&2
}

TEMPLATE=""
LIVE=""
ENVFILE=""
KEYS=()
DEFAULTS=()
declare -A PROVIDED=()
tmp=""
FAILED=0

select_name() {
  TEMPLATE="${SD_DIR}/templates/$1-template.hcl"
  LIVE="${SD_DIR}/$1.hcl"
  ENVFILE="${SD_DIR}/$1.env"
  KEYS=()
  DEFAULTS=()
  PROVIDED=()
}

index_of() {
  local i
  for i in "${!KEYS[@]}"; do
    if [[ "${KEYS[i]}" == "$1" ]]; then
      echo "${i}"
      return 0
    fi
  done
  return 1
}

discover() {
  local m key def
  [[ -r "${TEMPLATE}" ]] || { echo "Template not found: ${TEMPLATE}" >&2; return 1; }
  while IFS= read -r m; do
    [[ "${m}" =~ env\ \"([A-Za-z0-9_]+)\"\)\ \"([^\"]*)\" ]] || continue
    key="${BASH_REMATCH[1]}"
    def="${BASH_REMATCH[2]}"
    index_of "${key}" > /dev/null && continue
    KEYS+=("${key}")
    DEFAULTS+=("${def}")
  done < <(grep -oE 'env "[A-Za-z0-9_]+"\) "[^"]*"' "${TEMPLATE}")
}

valid_value() {
  local def="$1" val="$2"
  if [[ "${def}" =~ ${DURATION_RE} ]]; then
    [[ "${val}" =~ ${DURATION_RE} ]]
  elif [[ "${def}" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
    [[ "${val}" =~ ^[A-Za-z0-9._:-]+$ ]]
  elif [[ "${def}" =~ ^[0-9]+$ ]]; then
    [[ "${val}" =~ ^[0-9]+$ ]]
  else
    [[ "${val}" != *'"'* && "${val}" != *"\\"* && ! "${val}" =~ [[:cntrl:]] ]]
  fi
}

load_env() {
  local line key val i n=0
  [[ -f "${ENVFILE}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    n=$((n + 1))
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    if [[ ! "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      warn "${ENVFILE}:${n}: malformed line ignored: ${line}"
      continue
    fi
    key="${BASH_REMATCH[1]}"
    val="${BASH_REMATCH[2]}"
    if [[ "${val}" =~ ^\"(.*)\"$ || "${val}" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    fi
    if ! i="$(index_of "${key}")"; then
      warn "${ENVFILE}:${n}: unknown key ${key} ignored"
      continue
    fi
    if ! valid_value "${DEFAULTS[i]}" "${val}"; then
      warn "${ENVFILE}:${n}: invalid value for ${key}: '${val}' (expected like ${DEFAULTS[i]}), using the default"
      continue
    fi
    PROVIDED["${key}"]="${val}"
  done < "${ENVFILE}"
}

render_one() {
  local key vars=()
  discover
  load_env
  for key in "${!PROVIDED[@]}"; do
    vars+=("${key}=${PROVIDED[${key}]}")
  done
  tmp="$(mktemp "${SD_DIR}/.${LIVE##*/}.XXXXXX")"
  env -i PATH="${PATH}" "${vars[@]}" "${CONSUL_TEMPLATE:-consul-template}" \
    -template "${TEMPLATE}:${tmp}" -once > /dev/null
  if [[ ! -s "${tmp}" ]]; then
    echo "Rendering ${TEMPLATE} produced no valid output" >&2
    return 1
  fi
  chmod 0644 "${tmp}"
  mv -f "${tmp}" "${LIVE}"
  tmp=""
  echo "Rendered ${LIVE}"
}

rep() {
  local out="" n="$1"
  while ((n-- > 0)); do out+="─"; done
  printf '%s' "${out}"
}

show_one() {
  local i w1=3 w2=7
  discover
  for i in "${!KEYS[@]}"; do
    ((${#KEYS[i]} > w1)) && w1=${#KEYS[i]}
    ((${#DEFAULTS[i]} > w2)) && w2=${#DEFAULTS[i]}
  done
  echo
  echo "Sidecar Config (overridable by ${ENVFILE}, apply with ${SETUP_CMD})"
  echo
  echo "┌─$(rep "${w1}")─┬─$(rep "${w2}")─┐"
  printf '│ %-*s │ %-*s │\n' "${w1}" Key "${w2}" Default
  echo "├─$(rep "${w1}")─┼─$(rep "${w2}")─┤"
  for i in "${!KEYS[@]}"; do
    printf '│ %-*s │ %-*s │\n' "${w1}" "${KEYS[i]}" "${w2}" "${DEFAULTS[i]}"
  done
  echo "└─$(rep "${w1}")─┴─$(rep "${w2}")─┘"
  echo
}

each() {
  local fn="$1" name rc=0
  for name in "${NAMES[@]}"; do
    select_name "${name}"
    set +e
    (
      set -e
      trap '[[ -z "${tmp}" ]] || rm -f "${tmp}"' EXIT
      case "${fn}" in
        render) render_one ;;
        show) show_one ;;
      esac
    )
    rc=$?
    set -e
    if ((rc != 0)); then
      warn "${fn} failed for ${name}"
      FAILED=1
    fi
  done
}

case "${1:-}" in
  render | show) each "$1"; exit "${FAILED}" ;;
  *) usage ;;
esac
