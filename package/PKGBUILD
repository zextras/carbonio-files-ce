package() {
  _package_systemd
}

package__rocky_8() {
  _package_legacy
}

package__ubuntu_jammy() {
  _package_legacy
}

postinst() {
  getent group 'carbonio-files' >/dev/null ||
    groupadd -r 'carbonio-files'
  getent passwd 'carbonio-files' >/dev/null ||
    useradd -r -M -g 'carbonio-files' -s /sbin/nologin 'carbonio-files'

  mkdir -p "/var/log/carbonio/files/"
  chown carbonio-files:carbonio-files "/var/log/carbonio/files"

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-files.service >/dev/null 2>&1 || :
    systemctl enable carbonio-files-watches.service >/dev/null 2>&1 || :
    systemctl enable carbonio-files-sidecar.service >/dev/null 2>&1 || :
  fi

  if [ "$1" = "configure" ]; then
    carbonio-files-hcl migrate || :
    carbonio-files-hcl render || echo "WARNING: hcl render failed, run carbonio-files-setup"
  fi

  echo "======================================================"
  echo "Carbonio Files installed successfully!                "
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

posttrans() {
  carbonio-files-hcl migrate || :
  carbonio-files-hcl render || echo "WARNING: hcl render failed, run carbonio-files-setup"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl disable --now carbonio-files.service >/dev/null 2>&1 || :
    systemctl disable --now carbonio-files-watches.service >/dev/null 2>&1 || :
    systemctl disable --now carbonio-files-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/zextras/service-discover/carbonio-files.hcl
  if [ "$1" = "purge" ]; then
    rm -f /etc/zextras/service-discover/carbonio-files.env /etc/zextras/service-discover/carbonio-files.hcl.bak
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
