pkgname="carbonio-files-ce"
pkgver="2.1.9"
pkgrel="SNAPSHOT"
pkgdesc="Carbonio Files"
maintainer="Zextras <packages@zextras.com>"
arch=('x86_64')
license=("AGPL-3.0-only")
section="admin"
priority="optional"
url="https://www.zextras.com/"
# python3 has the SAME package name on every target distro, so it goes in the base depends. pika
# (the watch-bridge's RabbitMQ client) is vendored instead of depending on python3-pika: on EL8 the
# EPEL package Recommends twisted, whose Automat dep pins python3.6dist(attrs) and then breaks
# `dnf upgrade` against pgdg-common's py3.9 python3-attrs (CO-4708). NOTE: yap does NOT
# honor depends__<distro> suffix arrays (only build__/package__ FUNCTIONS are per-distro), so a
# distro-suffixed `depends__apt`/`depends__rocky_*` silently never reaches the package metadata.
depends=(
  "pending-setups"
  "service-discover"
  "service-discover-base"
  "carbonio-openjdk"
  "python3"
)

# pika 1.2.1 is the last release supporting python 3.6 (EL8 system python); verified importable on
# 3.6 through 3.13. Pure python, no runtime deps.
_pika_ver="1.2.1"

source=(
  "511-carbonio-files.sh"
  "carbonio-files"
  "carbonio-files.hcl"
  "carbonio-files.service"
  "carbonio-files-setup"
