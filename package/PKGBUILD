backup=(
  "etc/zextras/service-discover/carbonio-files.hcl"
)

_package_common() {
  install -Dm755 "${srcdir}/carbonio-files" \
    "${pkgdir}/usr/bin/carbonio-files"

  install -Dm755 "${srcdir}/carbonio-files-setup" \
    "${pkgdir}/usr/bin/carbonio-files-setup"

  install -Dm755 "${srcdir}/carbonio-files-ce.jar" \
    "${pkgdir}/usr/share/carbonio/carbonio-files-ce.jar"

  install -Dm644 "${srcdir}/carbonio-files.service" \
    "${pkgdir}/lib/systemd/system/carbonio-files.service"

  install -Dm644 "${srcdir}/carbonio-files.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-files.hcl"

  install -Dm644 "${srcdir}/511-carbonio-files.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/511-carbonio-files.sh"

  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/files/service-discover/intentions.json"

  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/files/service-discover/policies.json"

  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/files/service-discover/service-protocol.json"

  install -Dm644 "${srcdir}/service-router.json" \
    "${pkgdir}/etc/carbonio/files/service-discover/service-router.json"

  # Live-config bridge: republishes Consul KV changes to the message broker consumed by the app's
  # KeyValueChangedConsumer. carbonio-files-start-watches.sh is installed (with the distro-specific
  # python version/prefix substituted) in the per-distro build__* functions below.
  install -Dm644 "${srcdir}/carbonio-files-watches.service" \
    "${pkgdir}/lib/systemd/system/carbonio-files-watches.service"

  install -Dm755 "${srcdir}/carbonio-files-handle-kv-changes.py" \
    "${pkgdir}/usr/bin/carbonio-files-handle-kv-changes.py"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-files-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/carbonio-files-sidecar.service"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-files-sidecar.service" \
    "${pkgdir}/lib/systemd/system/carbonio-files-sidecar.service"
}

# Live-config bridge (matches carbonio-files Advanced): install carbonio-files-start-watches.sh and
# substitute its python placeholders. The pika (Python RabbitMQ client) it imports at runtime is
# provided by the system python3-pika package (see depends) instead of being vendored with pip at
# build time -- the yap-v2 build containers ship no pip3. The handler runs under the distro's
# default python3, which is exactly the interpreter python3-pika targets (3.6 el8, 3.9 el9, 3.10/3.12
# ubuntu). pika publishes the Consul KV changes to the message broker consumed by the app's
# KeyValueChangedConsumer.
build__ubuntu_focal() {
  install -Dm 755 "${srcdir}/carbonio-files-start-watches.sh" \
    "${pkgdir}/usr/bin/carbonio-files-start-watches.sh"

  sed -i "s/PYTHON_VER/3/g" \
    "${pkgdir}/usr/bin/carbonio-files-start-watches.sh"
  sed -i "s/PREFIX/common/g" \
    "${pkgdir}/usr/bin/carbonio-files-start-watches.sh"
}

build__ubuntu_jammy() {
  install -Dm 755 "${srcdir}/carbonio-files-start-watches.sh" \
    "${pkgdir}/usr/bin/carbonio-files-start-watches.sh"

  sed -i "s/PYTHON_VER/3/g" \
    "${pkgdir}/usr/bin/carbonio-files-start-watches.sh"
  sed -i "s/PREFIX/common/g" \
    "${pkgdir}/usr/bin/carbonio-files-start-watches.sh"
}

