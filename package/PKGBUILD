pkgname="carbonio-files-ce"
pkgver="2.1.0"
pkgrel="SNAPSHOT"
pkgdesc="Carbonio Files"
maintainer="Zextras <packages@zextras.com>"
arch=('x86_64')
license=("AGPL-3.0-only")
section="admin"
priority="optional"
url="https://www.zextras.com/"
# python3 + python3-pika (the watch-bridge's RabbitMQ client) have the SAME package name on every
# target distro (ubuntu universe, EPEL 8/9), so they go in the base depends. NOTE: yap does NOT
# honor depends__<distro> suffix arrays (only build__/package__ FUNCTIONS are per-distro), so a
# distro-suffixed `depends__apt`/`depends__rocky_*` silently never reaches the package metadata.
depends=(
  "pending-setups"
  "service-discover"
  "service-discover-base"
  "carbonio-openjdk"
  "python3"
  "python3-pika"
)

source=(
  "511-carbonio-files.sh"
  "carbonio-files"
  "carbonio-files.hcl"
  "carbonio-files.service"
  "carbonio-files-setup"
  "carbonio-files-sidecar.service"
  "carbonio-files-sidecar-legacy.service"
  "carbonio-files-ce.jar"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
  "service-router.json"
  "carbonio-files-watches.service"
  "carbonio-files-start-watches.sh"
  "carbonio-files-handle-kv-changes.py"
)
