{
  "Kind": "service-intentions",
  "Name": "carbonio-files",
  "Sources": [
    {
      "Name": "carbonio-proxy",
      "Permissions": [
        {
          "Action": "deny",
          "HTTP": {
            "PathPrefix": "/graphql",
            "Methods": [
              "POST"
            ],
            "Header": {
              "Name": "Internal",
              "Present": true
            }
          }
        },
        {
          "Action": "deny",
          "HTTP": {
            "PathPrefix": "/internal"
          }
        },
        {
          "Action": "allow",
          "HTTP": {
            "PathPrefix": "/"
          }
        }
      ]
    },
    {
      "Name": "carbonio-docs-connector",
      "Action": "allow"
    },
    {
      "Name": "carbonio-mailbox",
      "Action": "allow"
    },
    {
      "Name": "carbonio-videoserver-recorder",
      "Action": "allow"
    },
    {
      "name": "carbonio-message-broker",
      "action": "allow"
    }
  ]
}
