<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <licenses>
    <license>
      <comments>Copyright (C) 2022 Zextras, https://www.zextras.com</comments>
      <name>AGPL-3.0-only</name>
    </license>
  </licenses>

  <groupId>com.zextras.carbonio.files</groupId>
  <artifactId>carbonio-files-ce</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>pom</packaging>

  <name>carbonio-files-ce</name>

  <modules>
    <module>sdk</module>
    <module>app</module>
  </modules>

  <properties>
    <!-- Maven CI Friendly properties -->
    <revision>2.0.0</revision>

    <!-- Quarkus migration -->
    <quarkus.version>3.37.3</quarkus.version>
    <carbonio-quarkus-extensions.version>1.14.0-1</carbonio-quarkus-extensions.version>
    <!-- P6e: user-management REST client SDK (UserRepositoryImpl co-requisite). Replaces the
         retired carbonio-user-management-grpc-sdk now that files-ce is 100% gRPC-free. -->
    <carbonio-user-management-rest-sdk.version>1.3.0-1</carbonio-user-management-rest-sdk.version>
    <flatten-maven.version>1.7.3</flatten-maven.version>

    <!-- Test / build helper dependency versions (non-BOM) -->
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.23.0</mockito.version>

    <!-- Plugins -->
    <maven-compiler.version>3.15.0</maven-compiler.version>
    <maven-failsafe.version>3.5.6</maven-failsafe.version>
    <maven-jacoco.version>0.8.15</maven-jacoco.version>
    <maven-surefire.version>3.5.6</maven-surefire.version>
    <!-- Maven Central dropped the "sonar" prefix from the org.codehaus.mojo group metadata, so
         mvn sonar:sonar can no longer resolve the plugin prefix on its own; declared explicitly
         below to make the prefix resolvable from the project (from devel). -->
    <sonar-maven-plugin.version>5.5.0.6356</sonar-maven-plugin.version>

    <!-- Other properties -->
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <java-compiler.version>21</java-compiler.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sonar.coverage.jacoco.xmlReportPaths>
      ./app/target/jacoco-full-report/jacoco.xml
    </sonar.coverage.jacoco.xmlReportPaths>
    <sonar.dependencyCheck.htmlReportPath>
      ./dependency-check-report.html
    </sonar.dependencyCheck.htmlReportPath>

    <!-- Flags to skip/run tests and the report generation -->
    <skip.integration.tests>true</skip.integration.tests>
    <skip.unit.tests>true</skip.unit.tests>
    <skip.jacoco.full.report.generation>true</skip.jacoco.full.report.generation>
  </properties>

  <!--
    NOTE (Quarkus migration): the legacy <dependencyManagement> block (guice/netty/ebean/
    graphql-java/commons-io/jackson/... pins for the old Guice+Netty stack) was removed. The new
    `app` module manages all versions via the imported io.quarkus:quarkus-bom plus a few explicit
    non-BOM pins (extensions, assertj, mockito). Keeping the old pins here leaked incompatible
    transitive versions onto the Quarkus build classpath (e.g. commons-io 2.14.0 broke the
    commons-compress jar step in the augmentation). Versions for any legacy lib re-introduced
    during the port (e.g. graphql-java for the public schema in P3) are declared in `app` at that
    time, chosen to be Quarkus-BOM-compatible.
  -->

  <!-- Publish target for `mvn deploy` (the dt3 "Maven Publish" stage deploys the root pom with -N,
       and the app module inherits this; the sdk module gets its own from carbonio-quarkus-extensions-
       sdk-parent). Matches carbonio-user-management: the `zextras-java-sdk` id resolves to the
       credentials in the dt3-provided settings.xml. -->
  <distributionManagement>
    <snapshotRepository>
      <id>zextras-java-sdk</id>
      <name>Zextras private repository</name>
      <url>https://zextras.jfrog.io/artifactory/maven-snapshot</url>
    </snapshotRepository>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras private repository</name>
      <url>https://zextras.jfrog.io/artifactory/public-maven-repo</url>
    </repository>
  </distributionManagement>

  <build>
    <plugins>
      <!--
        CI-friendly versioning: resolve ${revision}${changelist} into the installed/published
        POMs. Bound at `validate` so the resolved version is available to the Quarkus build.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>validate</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Maven Central dropped the "sonar" prefix from the org.codehaus.mojo group
           metadata, so mvn sonar:sonar can no longer resolve the plugin prefix on its own.
           Declaring it here makes the prefix resolvable from the project (from devel). -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar-maven-plugin.version}</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <changelist>-SNAPSHOT</changelist>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties>
        <changelist></changelist>
      </properties>
    </profile>
  </profiles>

  <repositories>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras public maven repo</name>
      <url>https://zextras.jfrog.io/artifactory/java-sdk</url>
    </repository>
  </repositories>
</project>
