<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zextras.carbonio.quarkus</groupId>
    <artifactId>carbonio-quarkus-extensions-parent</artifactId>
    <version>1.16.0-1</version>
    <relativePath/>
  </parent>

  <licenses>
    <license>
      <comments>Copyright (C) 2022 Zextras, https://www.zextras.com</comments>
      <name>AGPL-3.0-only</name>
    </license>
  </licenses>

  <groupId>com.zextras.carbonio.files</groupId>
  <artifactId>carbonio-files-ce</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>pom</packaging>

  <name>carbonio-files-ce</name>

  <modules>
    <module>sdk</module>
    <module>app</module>
  </modules>

  <properties>
    <!-- Maven CI Friendly properties -->
    <revision>2.1.7</revision>

    <carbonio-quarkus-extensions.version>1.16.0-1</carbonio-quarkus-extensions.version>
    <!-- P6e: user-management REST client SDK (UserRepositoryImpl co-requisite). Replaces the
         retired carbonio-user-management-grpc-sdk now that files-ce is 100% gRPC-free. -->
    <carbonio-user-management-rest-sdk.version>1.3.3-1</carbonio-user-management-rest-sdk.version>

    <!-- Test / build helper dependency versions (non-BOM) -->
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.23.0</mockito.version>

    <!-- Other properties -->
    <sonar.coverage.jacoco.xmlReportPaths>
      ./app/target/jacoco-full-report/jacoco.xml
    </sonar.coverage.jacoco.xmlReportPaths>
    <sonar.dependencyCheck.htmlReportPath>
      ./dependency-check-report.html
    </sonar.dependencyCheck.htmlReportPath>

    <!-- Flags to skip/run tests and the report generation -->
    <skip.integration.tests>true</skip.integration.tests>
    <skip.unit.tests>true</skip.unit.tests>
    <skip.jacoco.full.report.generation>true</skip.jacoco.full.report.generation>
  </properties>

  <!--
    NOTE (Quarkus migration): the legacy <dependencyManagement> block (guice/netty/ebean/
    graphql-java/commons-io/jackson/... pins for the old Guice+Netty stack) was removed. Versions
    come from the carbonio-quarkus-extensions parent (Quarkus BOM, graphql-java, build plugins)
    plus a few explicit non-BOM pins (extensions, assertj, mockito). Keeping the old pins here
    leaked incompatible transitive versions onto the Quarkus build classpath (e.g. commons-io
    2.14.0 broke the commons-compress jar step in the augmentation).
  -->

  <!-- Publish target for `mvn deploy` (the dt3 "Maven Publish" stage deploys the root pom with -N,
       and the app module inherits this; the sdk module gets its own from carbonio-quarkus-extensions-
       sdk-parent). Matches carbonio-user-management: the `zextras-java-sdk` id resolves to the
       credentials in the dt3-provided settings.xml. -->
  <distributionManagement>
    <snapshotRepository>
      <id>zextras-java-sdk</id>
      <name>Zextras private repository</name>
      <url>https://zextras.jfrog.io/artifactory/maven-snapshot</url>
    </snapshotRepository>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras private repository</name>
      <url>https://zextras.jfrog.io/artifactory/public-maven-repo</url>
    </repository>
  </distributionManagement>

  <build>
    <plugins>
      <!--
        CI-friendly versioning: resolve ${revision}${changelist} into the installed/published
        POMs. Bound at `validate` so the resolved version is available to the Quarkus build.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <changelist>-SNAPSHOT</changelist>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties>
        <changelist></changelist>
      </properties>
    </profile>
  </profiles>

  <repositories>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras public maven repo</name>
      <url>https://zextras.jfrog.io/artifactory/java-sdk</url>
    </repository>
    <!-- carbonio-quarkus-extensions >= 1.15.3 is published to Nexus only (jenkins-lib-common v5). -->
    <repository>
      <id>zextras-nexus</id>
      <name>Zextras Nexus releases</name>
      <url>https://repo.zextras.tools/repository/public-maven-repo/</url>
    </repository>
  </repositories>
</project>
