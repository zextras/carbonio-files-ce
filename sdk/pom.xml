<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Pinned to the extensions snapshot published AFTER rest/sdk-support was removed, so its
    rest-sdk-parent no longer drags in carbonio-quarkus-extensions-rest-sdk-support. This module
    ships its OWN raw streaming helper in the com.zextras.carbonio.files.sdk.streaming package.
  -->
  <parent>
    <groupId>com.zextras.carbonio.quarkus</groupId>
    <artifactId>carbonio-quarkus-extensions-rest-sdk-parent</artifactId>
    <version>1.12.0-1</version>
    <relativePath/>
  </parent>

  <groupId>com.zextras.carbonio.files</groupId>
  <artifactId>carbonio-files-ce-rest-sdk</artifactId>
  <version>${revision}${changelist}</version>
  <name>Carbonio Files - REST SDK</name>

  <properties>
    <!-- Placeholder version, same as carbonio-user-management's sdk. This module parents on
         carbonio-quarkus-extensions-rest-sdk-parent (not the files root), and semantic-release's
         prepareCmd only rewrites the ROOT pom's <revision>, never this one. The real version is
         injected identically for every module by dt3 (-Drevision/-Dchangelist) at CI/release time,
         so the app's ${project.version} dependency on this module always resolves. For a bare local
         reactor build, pass -Drevision/-Dchangelist (as CI does). -->
    <revision>0.0.0</revision>
    <changelist>-SNAPSHOT</changelist>

    <!-- The committed OpenAPI spec to generate the /internal client from (FILTER=path:/internal is
         applied by the inherited openapi-generator execution), and the base Java package for the
         generated api/model/invoker sub-packages. -->
    <sdk.openapi.spec>${project.basedir}/../app/docs/openapi.yaml</sdk.openapi.spec>
    <sdk.base.package>com.zextras.carbonio.files.sdk</sdk.base.package>
  </properties>

  <repositories>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras public maven repo</name>
      <url>https://zextras.jfrog.io/artifactory/java-sdk</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        This module's ONLY tests are the hand-written, real-HttpServer RestStreamingSupportTest
        (unit tests, no *IT.java/*IntegrationTest.java present). The sdk-parent's inherited parent
        (carbonio-quarkus-extensions-parent) unconditionally binds maven-failsafe-plugin; when the
        reactor is run with a `-Dit.test=...` filter (e.g. the app's gate ITs) failsafe would
        otherwise abort here with "No tests matching pattern". Tolerate a no-match so a targeted
        reactor `verify` reaches the app module.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
      <!-- Skip generating the java.time RFC3339 helpers (RFC3339JavaTimeModule/RFC3339InstantDeserializer):
           the latter references jackson 2.16's JavaTimeFeature, which breaks this SDK on carbonio-mailbox's
           jackson 2.15. The /internal DTOs carry no date fields, so a tiny empty RFC3339JavaTimeModule
           (src/main/java) stands in and the rest of the generated client is kept as-is. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-rest-client</id>
            <configuration>
              <ignoreFileOverride>${project.basedir}/.openapi-generator-ignore</ignoreFileOverride>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
